# Firebase Web App Config
# Get these from: Firebase Console → Project Settings → Your Apps → SDK setup → Config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=intervent-fff28.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=intervent-fff28
VITE_FIREBASE_STORAGE_BUCKET=intervent-fff28.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Backend URL
VITE_BACKEND_URL=http://localhost:5001
